<?xml version="1.0" encoding="utf-8"?>
<!--
  Modern flavor: Material 3 dark theme with the Libre Radio (amber) palette
  (the same colors as LibreRadioTheme in Compose; used by the remaining View dialogs).
-->
<resources>

    <style name="AppTheme" parent="Theme.Material3.Dark">
        <item name="colorPrimary">#FFF0A848</item>
        <item name="colorOnPrimary">#FF000000</item>
        <item name="colorPrimaryContainer">#FF653E00</item>
        <item name="colorOnPrimaryContainer">#FFFFDDB8</item>
        <item name="colorSecondary">#FFDFC2A2</item>
        <item name="colorOnSecondary">#FF3F2D17</item>
        <item name="colorSecondaryContainer">#FF57432B</item>
        <item name="colorOnSecondaryContainer">#FFFCDDBD</item>
        <item name="colorTertiary">#FFBBCD9E</item>
        <item name="colorOnTertiary">#FF273513</item>
        <item name="android:colorBackground">#FF0E0D0B</item>
        <item name="colorOnBackground">#FFEEE0D4</item>
        <item name="colorSurface">#FF15130F</item>
        <item name="colorOnSurface">#FFEEE0D4</item>
        <item name="colorSurfaceVariant">#FF504539</item>
        <item name="colorOnSurfaceVariant">#FFD4C4B5</item>
        <item name="colorOutline">#FF9C8E80</item>
        <item name="colorSurfaceContainerLow">#FF211A13</item>
        <item name="colorSurfaceContainer">#FF251E17</item>
        <item name="colorSurfaceContainerHigh">#FF302921</item>
        <item name="colorSurfaceContainerHighest">#FF3B332B</item>
        <item name="android:windowBackground">#FF0E0D0B</item>
        <item name="lr_toolbarBackground">?attr/colorSurfaceContainer</item>
        <item name="android:statusBarColor">?attr/colorSurfaceContainer</item>
        <!-- DrawerLayout paints the status bar area with colorPrimaryDark. -->
        <item name="colorPrimaryDark">?attr/colorSurfaceContainer</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Dark" />

</resources>
