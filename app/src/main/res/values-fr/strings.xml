    <string name="player_connecting">Connexion à la station… %d s</string>
    <string name="player_rebuffering">Son interrompu, rechargement… %d s</string>
    <string name="player_buffering_explained">Mise en mémoire tampon : quelques secondes de son sont chargées d’avance pour éviter les coupures. Si c’est long, le lien avec la station est lent.</string>
    <string name="settings_eq_desc">Change le timbre : plus de basses, voix plus claire, etc. Ne concerne que Libre Radio.</string>
    <string name="settings_eq_waiting">Lancez une station : l’égaliseur apparaît dès que le son joue. Sinon, l’appareil n’en fournit pas.</string>
    <string name="settings_buffering_explained">Le tampon est du son chargé d’avance. Plus grand, la station démarre un peu plus tard mais coupe moins sur une mauvaise connexion.</string>
    <string name="settings_buffer_fast">Démarrage rapide</string>
    <string name="settings_buffer_fast_desc">Son en 1 s environ. Pour un bon Wi-Fi.</string>
    <string name="settings_buffer_normal">Normal</string>
    <string name="settings_buffer_normal_desc">Son en 2–3 s environ. Convient presque toujours.</string>
    <string name="settings_buffer_reliable">Fiable</string>
    <string name="settings_buffer_reliable_desc">Son en 5 s environ, moins de coupures. Pour les données mobiles, les trajets et une mauvaise connexion.</string>
