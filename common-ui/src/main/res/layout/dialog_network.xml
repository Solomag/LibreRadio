<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_network_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:text="@string/main_menu_network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center_horizontal"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <CheckBox
            android:id="@+id/use_mobile_network_check_box"
            android:text="@string/use_mobile_network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Proxy -->
        <TextView
            android:text="@string/proxy_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/proxy_state_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textSize="14sp"/>

        <TextView
            android:text="@string/proxy_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textSize="13sp"
            android:alpha="0.75"/>

        <CheckBox
            android:id="@+id/proxy_use_check_box"
            android:text="@string/proxy_use"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/proxy_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioGroup
                android:id="@+id/proxy_type_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/proxy_type_socks"
                    android:text="SOCKS5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <RadioButton
                    android:id="@+id/proxy_type_http"
                    android:text="HTTP"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <RadioButton
                    android:id="@+id/proxy_type_dpi"
                    android:text="@string/proxy_type_dpi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </RadioGroup>

            <!-- SOCKS5 or HTTP -->
            <LinearLayout
                android:id="@+id/proxy_server_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/proxy_host_edit"
                    android:hint="@string/proxy_host"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/proxy_port_edit"
                    android:hint="@string/proxy_port"
                    android:inputType="number"
                    android:maxLength="5"
                    android:singleLine="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/proxy_user_edit"
                    android:hint="@string/proxy_user"
                    android:inputType="text"
                    android:singleLine="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/proxy_password_edit"
                    android:hint="@string/proxy_password"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- ByeDPI -->
            <LinearLayout
                android:id="@+id/proxy_dpi_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:text="@string/proxy_dpi_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:alpha="0.75"/>

                <Button
                    android:id="@+id/proxy_dpi_pick_button"
                    android:text="@string/proxy_dpi_pick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/proxy_dpi_status_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:visibility="gone"/>

                <TextView
                    android:text="@string/proxy_dpi_args"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"/>

                <EditText
                    android:id="@+id/proxy_dpi_args_edit"
                    android:inputType="text|textNoSuggestions"
                    android:singleLine="true"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <Button
                android:id="@+id/proxy_test_button"
                android:text="@string/proxy_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/proxy_test_result_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- White server name -->
        <CheckBox
            android:id="@+id/white_sni_check_box"
            android:text="@string/white_sni_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>

        <TextView
            android:text="@string/white_sni_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:alpha="0.75"/>

        <LinearLayout
            android:id="@+id/white_sni_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:text="@string/white_sni_domain_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/white_sni_domain_edit"
                android:hint="vk.com"
                android:inputType="textUri"
                android:singleLine="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <Button
            android:id="@+id/network_save_button"
            android:text="@string/proxy_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
