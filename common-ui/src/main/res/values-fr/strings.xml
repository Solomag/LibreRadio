    <string name="proxy_title">Proxy</string>
    <string name="proxy_state_on">%1$s %2$s:%3$d, toute l’appli passe par lui</string>
    <string name="proxy_state_off">Désactivé</string>
    <string name="proxy_desc">Le catalogue, le son et les logos passent par le proxy : cela contourne les réseaux qui coupent les serveurs étrangers. Utilisez le proxy de votre service VPN ou une appli sur ce téléphone : ByeByeDPI, v2rayNG, Orbot (adresse 127.0.0.1, port de ses réglages). Le réseau local et Tailscale passent en direct.</string>
    <string name="proxy_use">Utiliser un proxy</string>
    <string name="proxy_host">Adresse</string>
    <string name="proxy_port">Port</string>
    <string name="proxy_user">Identifiant (si besoin)</string>
    <string name="proxy_password">Mot de passe (si besoin)</string>
    <string name="proxy_test">Tester</string>
    <string name="proxy_test_ok">Ça marche : catalogue chargé via le proxy (%1$d Ko en %2$.1f s)</string>
    <string name="proxy_test_cut">Via ce proxy la connexion se coupe aussi (après %d Ko) : il n’aide pas</string>
    <string name="proxy_test_failed">Le proxy n’a pas marché : %s</string>
    <string name="proxy_save">Enregistrer</string>
    <string name="proxy_state_dpi">Activé : ByeDPI sur ce téléphone</string>
    <string name="proxy_dpi_desc">ByeDPI est intégré à l’app : il tourne sur le téléphone même, sans serveur ni VPN. Il découpe et déguise le début de chaque connexion pour que le réseau ne sache pas où elle va. Il n’aide pas partout : touchez « Trouver » et l’app essaie ses méthodes une à une.</string>
    <string name="proxy_dpi_pick">Trouver</string>
    <string name="proxy_dpi_trying">Essai de la méthode %1$d sur %2$d…</string>
    <string name="proxy_dpi_found">La méthode %d fonctionne. Touchez Enregistrer.</string>
    <string name="proxy_dpi_none">Aucune méthode n’a aidé sur ce réseau : il faut un vrai proxy ou un VPN.</string>
    <string name="proxy_dpi_args">Options de ByeDPI</string>
    <string name="proxy_type_dpi">ByeDPI (intégré, sans serveur)</string>
    <string name="white_sni_title">Nom de serveur blanc</string>
    <string name="white_sni_desc">Les connexions sécurisées aux stations montrent au réseau le nom d’un site autorisé au lieu de celui de la station. Utile là où seuls les sites listés passent ou où les serveurs étrangers sont coupés. Le certificat reste vérifié ; les stations qui refusent se connectent normalement.</string>
    <string name="white_sni_domain">Site autorisé</string>
    <string name="white_sni_domain_desc">Un grand site qui marche toujours sur votre réseau, par exemple vk.com ou ya.ru.</string>
